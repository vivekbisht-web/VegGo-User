platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end

  # ── Copy Razorpay dSYMs into the archive so App Store Connect is happy ──
  # RazorpayStandard.xcframework already ships dSYMs inside its slices,
  # but Xcode doesn't copy them into the archive's dSYMs folder automatically.
  main_project = installer.aggregate_targets.first.user_project
  runner_target = main_project.targets.find { |t| t.name == 'Runner' }

  phase_name = '[Razorpay] Copy dSYMs'
  unless runner_target.shell_script_build_phases.any? { |p| p.name == phase_name }
    phase = runner_target.new_shell_script_build_phase(phase_name)
    phase.shell_script = <<~SCRIPT
      # Copy Razorpay dSYMs into the archive's dSYMs folder
      if [ "${ACTION}" = "install" ] && [ -d "${DWARF_DSYM_FOLDER_PATH}" ]; then
        # Razorpay core (UUID: EADA0557-2F58-3949-8E33-023E668C2CF9)
        RAZORPAY_CORE_DSYM="${PODS_ROOT}/razorpay-core-pod/Pod/core/Razorpay.xcframework/ios-arm64/dSYMs"
        if [ -d "${RAZORPAY_CORE_DSYM}" ]; then
          echo "[Razorpay dSYM] Copying core dSYMs from ${RAZORPAY_CORE_DSYM}"
          cp -R "${RAZORPAY_CORE_DSYM}/"*.dSYM "${DWARF_DSYM_FOLDER_PATH}/" 2>/dev/null || true
        fi
        # RazorpayStandard
        RAZORPAY_STD_DSYM="${PODS_ROOT}/razorpay-pod/Pod/RazorpayStandard.xcframework/ios-arm64/dSYMs"
        if [ -d "${RAZORPAY_STD_DSYM}" ]; then
          echo "[Razorpay dSYM] Copying standard dSYMs from ${RAZORPAY_STD_DSYM}"
          cp -R "${RAZORPAY_STD_DSYM}/"*.dSYM "${DWARF_DSYM_FOLDER_PATH}/" 2>/dev/null || true
        fi
      fi
    SCRIPT
    phase.input_paths = [
      '$(PODS_ROOT)/razorpay-core-pod/Pod/core/Razorpay.xcframework/ios-arm64/dSYMs/',
      '$(PODS_ROOT)/razorpay-pod/Pod/RazorpayStandard.xcframework/ios-arm64/dSYMs/',
    ]
    phase.output_paths = [
      '$(DWARF_DSYM_FOLDER_PATH)/Razorpay.framework.dSYM',
      '$(DWARF_DSYM_FOLDER_PATH)/RazorpayStandard.framework.dSYM',
    ]
    main_project.save
    puts "[Razorpay dSYM] Added '#{phase_name}' build phase to Runner target."
  end
end
